{% assign skincare_collection = section.settings.collection %}
{% assign products_limit = section.settings.products_to_show %}

<div class="page-width">
  <div class="title-block skincare__intro">
    {% if section.settings.eyebrow %}
      <h4>{{ section.settings.eyebrow }}</h4>
    {% endif %}
    {% if section.settings.heading %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.description %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="grid grid--uniform grid--2-col grid--2-col-tablet grid--4-col-desktop skincare__grid">
    {% if skincare_collection != blank and skincare_collection.products_count > 0 %}
      {% for product in skincare_collection.products limit: products_limit %}
        <div class="grid__item">
          <a href="{{ product.url }}" class="skincare__card">
            <div class="skincare__card-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title | escape }}" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'skincare__placeholder' }}
              {% endif %}
            </div>
            <div class="skincare__card-content">
              <h3 class="skincare__card-title">{{ product.title }}</h3>
              {% if section.settings.show_price %}
                <span class="skincare__card-price">
                  {% if product.price_varies %}From {% endif %}{{ product.price | money }}
                </span>
              {% endif %}
            </div>
          </a>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <div class="grid__item">
          <div class="skincare__card">
            <div class="skincare__card-image">
              {{ 'product-1' | placeholder_svg_tag: 'skincare__placeholder' }}
            </div>
            <div class="skincare__card-content">
              <h3 class="skincare__card-title">Nuovaderm Skincare</h3>
              {% if section.settings.show_price %}
                <span class="skincare__card-price">$00.00</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.button_label %}
    {% assign skincare_button_link = section.settings.button_link | default: skincare_collection.url %}
    <div class="skincare__footer">
      <a href="{{ skincare_button_link }}" class="th-btn">
        <span class="th-btn__label">{{ section.settings.button_label }}</span>
        <span class="th-btn__icon">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.99967 1.3335L14.6663 8.00016L7.99967 14.6668M14.6663 8.00016H1.33301" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "ND Skincare",
  "tag": "section",
  "class": "section skincare",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Skincare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nuovaderm Skincare"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Skincare and body-care essentials for your everyday routine."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Skincare Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products To Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Skincare"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "ND Skincare"
    }
  ]
}
{% endschema %}
