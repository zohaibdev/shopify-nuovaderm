{%  assign  version = 'dark' %}

{% if section.settings.versions == 'light' %}
  {% assign  version = 'light' %}
{% endif %}


<div class="page-width">
  <div class="devices__wrapper {% if version == 'light' %} devices__wrapper--light{% endif %}">
    <div class="title-block">
      {% if section.settings.eyebrow %}
        <h4>{{ section.settings.eyebrow }}</h4>
      {% endif %}
      {% if section.settings.heading %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>
    <div class="grid grid--2-col grid--1-col-tablet-down devices__cards">
      {% for block in section.blocks %}
        <div class="grid__item">
          <div class="devices__item">
            {% if block.settings.image %}
              <div class="devices__image">
                <img src="{{ block.settings.image | img_url: '400x' }}" alt="{{ block.settings.title }}">
              </div>
            {% endif %}
            <div class="devices__content">
              {% if block.settings.badge %}
                <span class="devices__badge">{{ block.settings.badge }}</span>
              {% endif %}
              {% if block.settings.title %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
              <div class="devices__buttons">
                {% if block.settings.primary_link and block.settings.primary_button_label %}
                  <a href="{{ block.settings.primary_link }}" class="devices__py-btn">
                    <span class="devices__py-btn-label">{{ block.settings.primary_button_label }}</span>
                    <span class="devices__py-btn-icon">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.99967 1.3335L14.6663 8.00016L7.99967 14.6668M14.6663 8.00016H1.33301" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </a>
                {% endif %}
                {% if block.settings.secondary_link and block.settings.secondary_button_label %}
                  <a href="{{ block.settings.secondary_link }}" class="devices__sy-btn">
                    <span class="devices__sy-btn-label">{{ block.settings.secondary_button_label }}</span>
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="devices__footer">
      {% if section.settings.other_products_text %}
        <h4>{{ section.settings.other_products_text }}</h4>
      {% endif %}
      {% if section.settings.button_link and section.settings.button_label %}
        <a href="{{ section.settings.button_link }}" class="th-btn">
          <span class="th-btn__label">{{ section.settings.button_label }}</span>
          <span class="th-btn__icon">
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.4041 8.70137L16.477 4.62839L12.4041 0.55542M16.477 4.62839H0.55542" stroke="currentColor" stroke-width="1.11081" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endif %}
  </div>
</div>


{% schema %}
{
  "name": "ND Device Compare",
  "tag": "section",
  "class": "section devices",
  "settings": [
    {
      "type": "radio",
      "id": "versions",
      "label": "Versions",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Devices"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which Dr. Pen is right for you?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "textarea",
      "id": "other_products_text",
      "label": "Other Products Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Shop All Dr. Pen Devices"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "device",
      "name": "Device",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "For Advanced Use"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Device Title",
          "default": "Dr. Pen M8S"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Best for advanced users seeking visible, clinical-level results."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "primary_button_label",
          "label": "Primary Button Label",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary Button Label",
          "default": "Compare Devices"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "Primary Button Link"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ND Device Compare",
      "blocks": [
        {
          "type": "device"
        },
        {
          "type": "device"
        }
      ]
    }
  ]
}
{% endschema %}
