<div class="anatomy__wrapper">
  <div class="page-width">
    <div class="grid grid--2-col-tablet grid--2-col-desktop">
      <div class="grid__item">
        <div class="title-block">
          {% if section.settings.subtitle %}
            <h4>{{ section.settings.subtitle }}</h4>
          {% endif %}
          {% if section.settings.title %}
            <h2>{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.content %}
            <p>{{ section.settings.content }}</p>
          {% endif %}
          {% if section.settings.button_label and section.settings.button_link %}
            <a href="{{ section.settings.button_link }}" class="th-btn">
              <span class="th-btn__label">{{ section.settings.button_label }}</span>
              <span class="th-btn__icon">
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12.4041 8.70137L16.477 4.62839L12.4041 0.55542M16.477 4.62839H0.55542" stroke="currentColor" stroke-width="1.11081" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>
      </div>
      <div class="grid__item">
        <div class="anatomy__image">
          {% if section.settings.image %}
            <img src="{{ section.settings.image | img_url: '800x' }}" alt="{{ section.settings.title }}" class="anatomy__main-image">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anatomy",
  "class": "anatomy",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Anatomy"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Built for real skin results, not guesswork."
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "Content",
      "default": "Every feature of the M8S is engineered to give you professional-level control and maximum skincare performance from home."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Find Your Routine"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Anatomy"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
