<div class="page-width">
  <div class="vip-nws__block">
    <div class="title-block">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subtext }}</p>
    </div>
    <div class="vip-nws__form">
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div
          class="newsletter-form__field-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <div class="vip-nws__field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="vip-nws__field-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="your@gmail.com"
              required
            >
            <button
              type="submit"
              class="th-btn vip-nws__field-button"
              name="commit"
              id="Subscribe"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >Join</button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <p
            class="newsletter-form__message newsletter-form__message--success form__message"
            id="Newsletter-success--{{ section.id }}"
            tabindex="-1"
            autofocus
          >
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            {{- 'newsletter.success' | t }}
          </p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
  <div class="perk__block">
    <div class="grid grid--1-col grid--2-col-tablet grid--4-col-desktop">
      {% for block in section.blocks %}
        <div class="grid__item perk__item">
          <div class="perk__icon">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | img_url: '100x' }}" alt="">
            {% endif %}
          </div>
          <div class="perk__content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "ND VIP Newsletter",
  "tag": "section",
  "class": "vip-nws",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the community the VIP list."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Quiet drops, routine science, early access, no noise."
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Built for real results"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Clear guidance and proven routines, every step."
        }

      ]
    }
  ],
  "presets": [
    {
      "name": "ND VIP Newsletter",
      "blocks": [
        {
          "type": "perk"
        },
        {
          "type": "perk"
        },
        {
          "type": "perk"
        },
        {
          "type": "perk"
        }
      ]
    }
  ]
}
{% endschema %}
