{% liquid
  assign section_id = 'dr-pen-authenticity-' | append: section.id
%}

<section id="{{ section_id }}" class="dr-pen-authenticity">
  <div class="page-width">
    <div class="grid grid--2-col grid--1-col-tablet-down">
        <div class="grid__item">
            <div class="dr-pen-authenticity__image">
            {% if section.settings.image != blank %}
                {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    class: 'dr-pen-authenticity__image-element',
                    alt: section.settings.image.alt | default: 'Dr. Pen authenticity verification'
                }}
            {% else %}
                <div class="dr-pen-authenticity__image-placeholder">
                {{ 'image' | placeholder_svg_tag }}
                </div>
            {% endif %}
            </div>
        </div>
        <div class="grid__item">
            <div class="dr-pen-authenticity__content">

            {% if section.settings.eyebrow != blank %}
                <div class="dr-pen-authenticity__eyebrow">
                {{ section.settings.eyebrow }}
                </div>
            {% endif %}

            {% if section.settings.heading != blank %}
                <h2 class="dr-pen-authenticity__heading">
                {{ section.settings.heading }}
                </h2>
            {% endif %}

            {% if section.settings.description != blank %}
                <div class="dr-pen-authenticity__description">
                {{ section.settings.description }}
                </div>
            {% endif %}

            <div class="dr-pen-authenticity__steps">

                {% for block in section.blocks %}
                <div
                    class="dr-pen-authenticity__step"
                    {{ block.shopify_attributes }}
                >
                    <div class="dr-pen-authenticity__step-number">
                    {{ forloop.index }}
                    </div>

                    <div class="dr-pen-authenticity__step-content">
                    {% if block.settings.title != blank %}
                        <h3>{{ block.settings.title }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                        <p>{{ block.settings.text }}</p>
                    {% endif %}
                    </div>
                </div>
                {% endfor %}

            </div>

            <div class="dr-pen-authenticity__verification">

                <div class="dr-pen-authenticity__website">
                <span class="dr-pen-authenticity__website-label">
                    Official verification website
                </span>

                <a
                    href="https://drpenreal.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="dr-pen-authenticity__website-link"
                >
                    DrPenReal.com
                    <span aria-hidden="true">↗</span>
                </a>
                </div>
                <a href="https://drpenreal.com" class="th-btn">
                    <span class="th-btn__label">{{ section.settings.button_text }}</span>
                        <span class="th-btn__icon">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M7.99967 1.3335L14.6663 8.00016L7.99967 14.6668M14.6663 8.00016H1.33301" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </a>
            </div>

            </div>
        </div>
    </div>

  </div>
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }



  #{{ section_id }} .dr-pen-authenticity__image-element {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_radius }}px;
  }

  #{{ section_id }} .dr-pen-authenticity__image-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f3f3f3;
    border-radius: {{ section.settings.image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .dr-pen-authenticity__image-placeholder svg {
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .dr-pen-authenticity__eyebrow {
    margin-bottom: 12px;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__heading {
    margin: 0 0 18px;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: {{ section.settings.heading_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__description {
    margin-bottom: 30px;
    font-size: 16px;
    line-height: 1.65;
    color: {{ section.settings.muted_text_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__description p {
    margin: 0;
  }

  #{{ section_id }} .dr-pen-authenticity__steps {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-bottom: 32px;
  }

  #{{ section_id }} .dr-pen-authenticity__step {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  #{{ section_id }} .dr-pen-authenticity__step-number {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: {{ section.settings.accent_color }};
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 700;
  }

  #{{ section_id }} .dr-pen-authenticity__step-content h3 {
    margin: 0 0 5px;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__step-content p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: {{ section.settings.muted_text_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__verification {
    padding-top: 25px;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__website {
    margin-bottom: 20px;
  }

  #{{ section_id }} .dr-pen-authenticity__website-label {
    display: block;
    margin-bottom: 5px;
    font-size: 13px;
    line-height: 1.4;
    color: {{ section.settings.muted_text_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__website-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 17px;
    line-height: 1.4;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #{{ section_id }} .dr-pen-authenticity__website-link:hover {
    color: {{ section.settings.accent_color }};
  }

  #{{ section_id }} .dr-pen-authenticity__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 52px;
    padding: 14px 26px;
    background: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
    border-radius: {{ section.settings.button_radius }}px;
    font-size: 14px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: .6px;
    text-decoration: none;
    text-transform: uppercase;
    transition: all .2s ease;
  }

  #{{ section_id }} .dr-pen-authenticity__button:hover {
    opacity: .88;
    transform: translateY(-1px);
  }

  .dr-pen-authenticity .grid {
        align-items: center;
    }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .dr-pen-authenticity__container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #{{ section_id }} .dr-pen-authenticity__content {
      max-width: none;
    }

    #{{ section_id }} .dr-pen-authenticity__heading {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-left: 16px;
      padding-right: 16px;
    }

    #{{ section_id }} .dr-pen-authenticity__container {
      gap: 30px;
    }

    #{{ section_id }} .dr-pen-authenticity__heading {
      font-size: 30px;
    }

    #{{ section_id }} .dr-pen-authenticity__description {
      font-size: 15px;
    }

    #{{ section_id }} .dr-pen-authenticity__step-content h3 {
      font-size: 16px;
    }

    #{{ section_id }} .dr-pen-authenticity__step-content p {
      font-size: 14px;
    }

    #{{ section_id }} .dr-pen-authenticity__button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Dr. Pen Authenticity",
  "tag": "section",
  "class": "dr-pen-authenticity-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Authenticity image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "100% Authentic"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Verify Your Dr. Pen Authenticity"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every authentic Dr. Pen device can be verified using the security code found on the product packaging.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Verify Your Dr. Pen"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Verification step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Scratch the security label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step description",
          "default": "Scratch the security label on your Dr. Pen product packaging to reveal the security information."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dr. Pen Authenticity",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Scratch the security label",
            "text": "Scratch the security label on the product packaging."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Find your security code",
            "text": "Locate the authentication or security code revealed underneath the label."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Verify your Dr. Pen",
            "text": "Go directly to the official Dr. Pen verification website and enter your code to confirm authenticity."
          }
        }
      ]
    }
  ]
}
{% endschema %}