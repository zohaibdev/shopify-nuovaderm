    <div class="page-width">
  <div class="system-steps__wrapper">
    <div class="title-block">
      {% if section.settings.eyebrow %}
        <h4>{{ section.settings.eyebrow }}</h4>
      {% endif %}
      {% if section.settings.heading %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>
    <div class="grid grid--3-col grid--1-col-tablet-down system-steps__cards">
      {% for block in section.blocks %}
        <div class="grid__item">
          <div class="system-steps__item">
            {% if block.settings.icon %}
              <img src="{{ block.settings.icon | img_url: '100x100' }}" alt="{{ block.settings.title }}">
            {% endif %}
            {% if block.settings.title %}
              <h4>{{ block.settings.title }}</h4>
            {% endif %}
            {% if block.settings.subtitle %}
              <p>{{ block.settings.subtitle }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ND System Steps",
  "tag": "section",
  "class": "section system-steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The System"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Understand your skin. Choose the right device. Get better results."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Microneedling can transform your skin. We built a guided system so every user gets safe and informed results."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Device"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "The Engine"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ND System Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
