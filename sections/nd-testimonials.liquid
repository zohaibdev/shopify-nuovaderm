<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/14.0.5/swiper-bundle.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/14.0.5/swiper-bundle.min.js"></script>

{%- assign hide_bg_class = "" -%}

{%- if section.settings.remove_bg == true -%}
    {%- assign hide_bg_class = "testi__wrapper--rmbg" -%}
{%- endif -%}

<div class="testi__wrapper {{ hide_bg_class }}">
    <div class="page-width">
        <div class="title-block">
            {%- if section.settings.subtitle -%}
                <h4>{{ section.settings.subtitle }}</h4>
            {%- endif -%}
            {%- if section.settings.title -%}
                <h2>{{ section.settings.title }}</h2>
            {%- endif -%}
        </div>
        <div class="testi__reviews">
            <div class="swiper customerTestimonials">
                <div class="swiper-wrapper">
                    {%- for block in section.blocks -%}
                        <div class="swiper-slide">
                            <div class="testi__item">
                                <div class="testi__item-stars">
