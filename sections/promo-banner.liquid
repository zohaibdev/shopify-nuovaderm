
<div class="promo-banner__wrapper" style="background-image: url({{ section.settings.background_image | img_url: '2048x' }});">
  <div class="page-width">
    <div class="grid grid--2-col grid--1-col-tablet-down">
      <div class="grid__item title-block">
        <h4>{{ section.settings.eyebrow }}</h4>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
        {% if section.settings.button_label and section.settings.button_link %}
          <a href="{{ section.settings.button_link }}" class="th-btn th-btn--light">
            <span class="th-btn__label">{{ section.settings.button_label }}</span>
            <span class="th-btn__icon">
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.4041 8.70137L16.477 4.62839L12.4041 0.55542M16.477 4.62839H0.55542" stroke="currentColor" stroke-width="1.11081" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
          </a>
        {% endif %}
      </div>
      {% if section.settings.foreground_image %}
        <div class="grid__item promo-banner__image-wrapper">
          <div class="promo-banner__image">
            <img src="{{ section.settings.foreground_image | img_url: '2048x' }}" alt="">
          </div>
        </div>  
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ND Promo Banner",
  "tag": "section",
  "class": "promo-banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A Complimentary Gift"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Complimentary Derma Stamp with eligible orders."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "To support your skincare journey, include a complimentary derma stamp with qualifying purchases."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Find Your Routine"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground Image"
    }
  ],
  "presets": [
    {
      "name": "ND Promo Banner"
    }
  ]
}
{% endschema %}
