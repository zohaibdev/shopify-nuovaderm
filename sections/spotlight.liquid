<div class="beginners__wrapper">
  <div class="page-width">
    <div class="grid grid--2-col-desktop grid--1-col-tablet-down">
      <div class="grid__item">
        <div class="title-block">
          {% if section.settings.eyebrow %}
            <h4>{{ section.settings.eyebrow }}</h4>
          {% endif %}
          {% if section.settings.heading %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description %}
            <p>{{ section.settings.description }}</p>
          {% endif %}
          {% if section.settings.button_label and section.settings.button_link %}
            <a href="{{ section.settings.button_link }}" class="th-btn">
                <span class="th-btn__label">{{ section.settings.button_label }}</span>
                <span class="th-btn__icon">
                    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12.4041 8.70137L16.477 4.62839L12.4041 0.55542M16.477 4.62839H0.55542" stroke="currentColor" stroke-width="1.11081" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </a>
          {% endif %}
        </div>
        <div class="beginners__shape">
          <svg width="734" height="402" viewBox="0 0 734 402" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M710.031 387.158L723.569 401.022L733.138 378.966M723.652 399.977C717.906 318.914 689.286 241.143 641.113 175.694C592.94 110.245 527.191 59.8016 451.5 30.2208C375.808 0.640026 293.279 -6.86486 213.493 8.57742C133.708 24.0197 59.9383 61.7757 0.75 117.462L1.77835 118.555C60.7599 63.0633 134.271 25.4391 213.779 10.0508C293.286 -5.33753 375.527 2.14114 450.954 31.6186C526.381 61.096 591.9 111.363 639.904 176.584C687.909 241.804 716.429 319.303 722.155 400.083L723.652 399.977Z" stroke="#1E395E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <div class="grid__item">
        <div class="beginners__image">
          {% if section.settings.main_image %}
            <img src="{{ section.settings.main_image | img_url: '800x' }}" alt="Main Image" class="beginners__main-image">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "ND Beginners Spotlight",
  "tag": "section",
  "class": "section beginners",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For Beginners"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New to microneedling? You're exactly who we built this for."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "You do not need prior expertise to get started. Every purchase includes guidance to build confidence."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Find Your Routine"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    }
  ],
  "presets": [
    {
      "name": "ND Beginners Spotlight"
    }
  ]
}
{% endschema %}
