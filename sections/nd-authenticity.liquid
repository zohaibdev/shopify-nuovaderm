<div class="page-width">
  <div class="authenticity__wrapper">
    <div class="grid grid--2-col grid--1-col-tablet-down authenticity__grid">
      <div class="grid__item">
        <div class="authenticity__image">
          {% if section.settings.image %}
            <img src="{{ section.settings.image | img_url: '900x' }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'authenticity__placeholder' }}
          {% endif %}
        </div>
      </div>
      <div class="grid__item">
        <div class="authenticity__content">
          <div class="title-block">
            {% if section.settings.eyebrow %}
              <h4>{{ section.settings.eyebrow }}</h4>
            {% endif %}
            {% if section.settings.heading %}
              <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.description %}
              <p>{{ section.settings.description }}</p>
            {% endif %}
          </div>

          {% if section.blocks.size > 0 %}
            <div class="authenticity__steps">
              {% for block in section.blocks %}
                <span class="authenticity__step" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                {% unless forloop.last %}
                  <span class="authenticity__step-arrow" aria-hidden="true">
                    <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.4041 8.70137L16.477 4.62839L12.4041 0.55542M16.477 4.62839H0.55542" stroke="currentColor" stroke-width="1.11081" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {% endunless %}
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.button_label %}
            <a
              href="{{ section.settings.button_link | default: 'https://drpenreal.com' }}"
              class="th-btn th-btn--light authenticity__button"
              target="_blank"
              rel="noopener noreferrer">
              <span class="th-btn__label">{{ section.settings.button_label }}</span>
              <span class="th-btn__icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.99967 1.3335L14.6663 8.00016L7.99967 14.6668M14.6663 8.00016H1.33301" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ND Authenticity",
  "tag": "section",
  "class": "section authenticity",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Authenticity Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Authenticity"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Genuine Dr. Pen. Verify It Yourself."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every Dr. Pen device we sell includes a security authentication code. Scratch the security label on the packaging and verify the code directly through Dr. Pen's authentication website."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Verify Authenticity"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "info": "Links to DrPenReal.com by default."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Scratch"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ND Authenticity",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "Scratch"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Verify"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Confirm"
          }
        }
      ]
    }
  ]
}
{% endschema %}
